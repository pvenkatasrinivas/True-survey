# Copy the values you need into your terminal or IDE run configuration.
# Never commit real passwords.

# Backend (required)
DB_PASSWORD=your_postgres_password_here

# Backend (optional - defaults shown)
DB_URL=jdbc:postgresql://localhost:5432/truesurvey
DB_USERNAME=postgres
CORS_ALLOWED_ORIGINS=http://localhost:5174
PORT=8081

# Frontend (put in frontend/.env only if the backend is not on localhost:8081)
VITE_API_BASE_URL=http://localhost:8081
